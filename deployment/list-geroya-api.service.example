[Unit]
Description=List Geroya 5e FastAPI
After=network.target

[Service]
User=list-geroya
WorkingDirectory=/srv/herolist/backend
EnvironmentFile=/etc/list-geroya/api.env
ExecStart=/srv/herolist/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
